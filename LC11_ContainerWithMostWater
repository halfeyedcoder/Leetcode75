class Solution {
    public int maxArea(int[] height) {
        int i=0,j=height.length-1;
        int max=0;
        while(i<j)
        {
            int current=Math.min(height[i],height[j])*(j-i);
            if(current>max)
                max=current;
            if(height[i]<height[j])
                i++;
            else j--;    
        }
        return max;
    }
}
