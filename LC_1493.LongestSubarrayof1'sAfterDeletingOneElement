class Solution {
    public int longestSubarray(int[] nums) {
        int left=0, maxLength=0, numOfZeroes=0,k=1;
        for(int right=0;right<nums.length;right++)
        {
            if(nums[right]==0)
                numOfZeroes++;
            while(numOfZeroes>k)
            {
                if(nums[left]==0)
                    numOfZeroes-=1;
                left++;    
            }
            maxLength=Math.max(maxLength, right-left);
        }
        return maxLength;
    }
}
