class Solution {
    public String gcdOfStrings(String str1, String str2) {
        int m=str1.length();
        int n=str2.length();
        //gcd of Two lengths
        if(!(str1+str2).equals(str2+str1))
            return "";
        else {
            return str1.substring(0,gcd(m,n));
        }    
    }
    public int  gcd(int x,int y)
    {
       if(y==0)
            return x;
       else 
            return gcd(y,x%y);
    }
    
}
