class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
   //loop through an array of candies and we checked for maximum number of candies
   int maxCandies=0;
   List<Boolean> result=new ArrayList<>();
    for(int num:candies)
    {
        maxCandies=Math.max(num, maxCandies);
    }
    //loop through an array again to se if kid has maximum number of candies 
    for(int i=0;i<candies.length;i++)
    {
            result.add(candies[i]+extraCandies>=maxCandies);
    }
    return result;
    }
}
